# Untouched originals of the tree photos, kept locally as a safety net.
#
# The files in images/trees/ are converted to real JPEG at 1200px for the web
# — that conversion is lossy and irreversible, so the originals live here.
# They are deliberately NOT committed: keeping them would put the full-size
# copies in git history permanently, which is exactly what downsizing avoids.
# Back them up somewhere real (not just here) if they matter to you.
images/trees/_originals/

# Same idea for hike photos: untouched phone originals, one folder per hike
# id. The resized copies in images/trails/<id>/ are what gets published.
images/trails/_originals/

# Fixtures the tests generate at run time — regenerated on every run.
tests/fixtures-*.js

# Design concept mockups — local only, never published. The site deploys
# straight from main, so anything committed here would be public.
concepts/

# macOS
.DS_Store
